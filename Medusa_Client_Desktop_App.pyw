class MedusaApp:
    def __init__(self, root):
        self.root = root
        root.title("Medusa Client")
        root.geometry("1180x760")
        root.minsize(900,600)
        root.configure(bg=BG)

        self.style = ttk.Style()
        self.style.theme_use("clam")
        self.style.configure("TEntry", fieldbackground="#0a0e16", foreground=TEXT)
        self.style.configure("TScrollbar", background="#111522", troughcolor="#07080d")

        self.logo = self.make_logo()
        self.pages = {}
        self.nav_buttons = {}
        self.build()

    def make_logo(self):
        try:
            from PIL import Image, ImageTk
            raw = base64.b64decode(DITTO_B64)
            im = Image.open(io.BytesIO(raw)).resize((48,48))
            return ImageTk.PhotoImage(im)
        except Exception:
            return None

    def build(self):
        title = tk.Frame(self.root,bg="#0b0e15",height=64)
        title.pack(fill="x")
        title.pack_propagate(False)

        if self.logo:
            tk.Label(title,image=self.logo,bg="#0b0e15").pack(side="left",padx=(16,10))
        else:
            tk.Label(title,text="●",fg=ACCENT2,bg="#0b0e15",font=("Segoe UI",22)).pack(side="left",padx=16)

        tk.Label(title,text="MEDUSA",fg=TEXT,bg="#0b0e15",
                 font=("Segoe UI",18,"bold")).pack(side="left")
        tk.Label(title,text="CLIENT",fg="#aaa5c4",bg="#0b0e15",
                 font=("Segoe UI",9)).pack(side="left",padx=8,pady=(6,0))

        tk.Label(title,text="DESKTOP APP",fg="#666d84",bg="#0b0e15",
                 font=("Segoe UI",8)).pack(side="left",padx=15)

        tk.Button(title,text="×",command=self.root.destroy,bg="#111521",fg="#adb3ca",
                  activebackground="#25182e",activeforeground="white",bd=0,
                  font=("Segoe UI",13),width=3).pack(side="right",padx=12,pady=13)

        body = tk.Frame(self.root,bg=BG)
        body.pack(fill="both",expand=True)

        side = tk.Frame(body,bg="#080a10",width=220)
        side.pack(side="left",fill="y")
        side.pack_propagate(False)

        items = [
            ("⌂","Home","home"),("</>","Script Library","library"),("⌁","Debugger","debugger"),
            ("◈","Protection","protection"),("▤","Script Maker","maker"),
            ("▣","Game Copier","copier"),("◌","Logs","logs"),
            ("⚙","Settings","settings"),("ⓘ","About","about")
        ]
        for icon,label,key in items:
            b = tk.Button(side,text=f"{icon}   {label}",anchor="w",command=lambda k=key:self.show(k),
                          bg="#080a10",fg="#9ca2bb",activebackground="#171323",
                          activeforeground="white",bd=0,relief="flat",
                          font=("Segoe UI",10),padx=18,pady=11)
            b.pack(fill="x",padx=8,pady=2)
            self.nav_buttons[key]=b

        bottom = tk.Frame(side,bg="#0c0d15",highlightthickness=1,highlightbackground="#31264c")
        bottom.pack(side="bottom",fill="x",padx=10,pady=12)
        if self.logo:
            tk.Label(bottom,image=self.logo,bg="#0c0d15").pack(side="left",padx=8,pady=8)
        txt=tk.Frame(bottom,bg="#0c0d15")
        txt.pack(side="left")
        tk.Label(txt,text="Medusa",fg=TEXT,bg="#0c0d15",font=("Segoe UI",10,"bold")).pack(anchor="w")
        tk.Label(txt,text="Launcher ready",fg="#777d95",bg="#0c0d15",font=("Segoe UI",8)).pack(anchor="w")

        self.content = tk.Frame(body,bg=BG)
        self.content.pack(side="left",fill="both",expand=True)

        for key in ["home","library","debugger","protection","maker","copier","logs","settings","about"]:
            self.pages[key]=tk.Frame(self.content,bg=BG)

        self.home_page()
        self.library_page()
        self.debugger_page()
        self.protection_page()
        self.maker_page()
        self.copier_page()
        self.logs_page()
        self.settings_page()
        self.about_page()
        self.show("home")

    def heading(self,parent,title,sub):
        tk.Label(parent,text=title,fg=TEXT,bg=BG,font=("Segoe UI",24,"bold")).pack(anchor="w",padx=26,pady=(24,2))
        tk.Label(parent,text=sub,fg=MUTED,bg=BG,font=("Segoe UI",10)).pack(anchor="w",padx=26,pady=(0,18))

    def card(self,parent,title,desc,command=None):
        f=tk.Frame(parent,bg=PANEL,highlightthickness=1,highlightbackground=BORDER)
        f.pack(side="left",fill="both",expand=True,padx=5,pady=5)
        tk.Label(f,text=title,fg=ACCENT2,bg=PANEL,font=("Segoe UI",14,"bold")).pack(anchor="w",padx=14,pady=(13,5))
        tk.Label(f,text=desc,fg="#858ca7",bg=PANEL,justify="left",wraplength=190,
                 font=("Segoe UI",9)).pack(anchor="w",padx=14,pady=(0,10))
        if command:
            tk.Button(f,text="Open →",command=command,bg="#0b0e15",fg="#cda5ff",
                      activebackground=ACCENT,activeforeground="white",bd=1,relief="solid",
                      font=("Segoe UI",9,"bold")).pack(anchor="w",padx=14,pady=(0,14))
        return f

    def home_page(self):
        p=self.pages["home"]
        hero=tk.Frame(p,bg="#111522",highlightthickness=1,highlightbackground=BORDER,height=210)
        hero.pack(fill="x",padx=26,pady=(24,0)); hero.pack_propagate(False)
        if self.logo:
            tk.Label(hero,image=self.logo,bg="#111522").place(x=22,y=20,width=170,height=170)
        tk.Label(hero,text="WELCOME TO",fg="#b8afd3",bg="#111522",
                 font=("Segoe UI",9,"bold")).place(x=215,y=28)
        tk.Label(hero,text="MEDUSA CLIENT",fg="#e9d5ff",bg="#111522",
                 font=("Segoe UI",28,"bold")).place(x=215,y=52)
        tk.Label(hero,text="Medusa is a script library, executor interface, anti-detector,",
                 fg="#a7acc1",bg="#111522",font=("Segoe UI",10)).place(x=215,y=103)
        tk.Label(hero,text="crash protection, debugger, and more features in one desktop app.",
                 fg="#a7acc1",bg="#111522",font=("Segoe UI",10)).place(x=215,y=126)
        tk.Label(hero,text="Native desktop interface • No browser window",
                 fg=GOOD,bg="#111522",font=("Segoe UI",9)).place(x=215,y=158)

        tk.Label(p,text="CORE AREAS",fg="#d6d1e7",bg=BG,font=("Segoe UI",10,"bold")).pack(anchor="w",padx=26,pady=(22,8))
        row=tk.Frame(p,bg=BG); row.pack(fill="x",padx=20)
        self.card(row,"Script Library","Scripts and all Medusa tools in one place.",lambda:self.show("library"))
        self.card(row,"Debugger","Generate and inspect diagnostic events.",lambda:self.show("debugger"))
        self.card(row,"Protection","Stability, integrity, recovery and diagnostics.",lambda:self.show("protection"))
        self.card(row,"Script Maker","Edit and organize script text.",lambda:self.show("maker"))

    def library_page(self):
        p=self.pages["library"]
        self.heading(p,"Script Library","All scripts and tools are combined here in one searchable desktop library.")
        top=tk.Frame(p,bg=BG); top.pack(fill="x",padx=26,pady=(0,10))
        self.search=tk.Entry(top,bg="#0a0e16",fg=TEXT,insertbackground="white",relief="flat",
                             highlightthickness=1,highlightbackground=BORDER,font=("Segoe UI",10))
        self.search.pack(side="left",fill="x",expand=True,ipady=9)
        self.search.insert(0,"Search scripts and tools...")
        self.search.bind("<FocusIn>",lambda e:self.search.delete(0,"end") if self.search.get()=="Search scripts and tools..." else None)
        self.search.bind("<KeyRelease>",lambda e:self.render_library())
        self.lib_canvas=tk.Canvas(p,bg=BG,highlightthickness=0)
        self.lib_scroll=ttk.Scrollbar(p,orient="vertical",command=self.lib_canvas.yview)
        self.lib_canvas.configure(yscrollcommand=self.lib_scroll.set)
        self.lib_canvas.pack(side="left",fill="both",expand=True,padx=(26,0))
        self.lib_scroll.pack(side="right",fill="y",padx=(0,16))
        self.lib_frame=tk.Frame(self.lib_canvas,bg=BG)
        self.lib_canvas.create_window((0,0),window=self.lib_frame,anchor="nw")
        self.lib_frame.bind("<Configure>",lambda e:self.lib_canvas.configure(scrollregion=self.lib_canvas.bbox("all")))
        self.render_library()

    def render_library(self):
        for w in self.lib_frame.winfo_children(): w.destroy()
        q=self.search.get().lower()
        items=[(n,d) for n,d in SCRIPTS if q in n.lower() or q in d.lower()]
        items += [(n,"Medusa utility tool.") for n in TOOLS if q in n.lower()]
        for i,(name,desc) in enumerate(items):
            r,c=divmod(i,4)
            f=tk.Frame(self.lib_frame,bg=PANEL,highlightthickness=1,highlightbackground=BORDER)
            f.grid(row=r,column=c,padx=5,pady=5,sticky="nsew")
            tk.Label(f,text="✦",fg=ACCENT2,bg=PANEL,font=("Segoe UI",16,"bold")).pack(anchor="w",padx=12,pady=(10,2))
            tk.Label(f,text=name,fg=TEXT,bg=PANEL,font=("Segoe UI",10,"bold")).pack(anchor="w",padx=12)
            tk.Label(f,text=desc,fg="#858ca7",bg=PANEL,wraplength=180,justify="left",
                     font=("Segoe UI",8)).pack(anchor="w",padx=12,pady=5)
            tk.Button(f,text="Open",command=lambda n=name:self.notify(n+" opened"),
                      bg="#0b0e15",fg="#cda5ff",bd=1,relief="solid").pack(anchor="w",padx=12,pady=(0,10))

    def debugger_page(self):
        p=self.pages["debugger"]; self.heading(p,"Debugger","Run a local diagnostic pass and inspect generated logs.")
        bar=tk.Frame(p,bg=BG); bar.pack(fill="x",padx=26,pady=(0,10))
        tk.Button(bar,text="▶ Play",command=self.start_debug,bg=ACCENT,fg="white",bd=0,padx=16,pady=8).pack(side="left")
        tk.Button(bar,text="Clear",command=lambda:self.console.delete("1.0","end"),bg=PANEL2,fg="#c3c8da",bd=1,pady=7).pack(side="left",padx=7)
        self.debug_status=tk.Label(bar,text="Ready",fg=MUTED,bg=BG); self.debug_status.pack(side="left",padx=8)
        self.console=tk.Text(p,bg="#070a10",fg="#aeb4c9",insertbackground="white",relief="flat",
                             highlightthickness=1,highlightbackground=BORDER,font=("Consolas",9))
        self.console.pack(fill="both",expand=True,padx=26,pady=(0,14))
        self.console.insert("end","✓ Diagnostic console ready\n")

    def start_debug(self):
        self.console.delete("1.0","end")
        total=random.randint(40,200)
        for i in range(total):
            self.console.insert("end",f"[{time.strftime('%H:%M:%S')}] diagnostic event #{i+1:03d} — {random.choice(['parser checked','resource verified','state synchronized','event inspected','dependency checked','input handler ready','cache validated','session healthy'])}\n")
        self.console.insert("end",f"\n✓ Diagnostic pass complete — {total} logs generated\n")
        self.debug_status.config(text=f"Complete · {total}")
        self.notify(f"{total} diagnostic logs generated")

    def protection_page(self):
        p=self.pages["protection"]; self.heading(p,"Protection Center","Stability, integrity, recovery, and diagnostic controls.")
        grid=tk.Frame(p,bg=BG); grid.pack(fill="both",expand=True,padx=20)
        entries=[
            ("Anti Error","Tracks errors and presents recovery actions."),
            ("Anti Closer","Client session watchdog interface."),
            ("UAS Crash Bypass","Crash-detection and recovery workflow."),
            ("CashClient Dero","Watchdog for unexpected script stoppages."),
            ("File Checker","Checks whether a file is complete and readable."),
            ("Error Identifier & Bypasser","Explains an error and opens the AI recovery workflow."),
            ("Anti Detect 1","Low-protection compatibility profile."),
            ("Anti Detect 2","Higher-protection compatibility profile."),
            ("Integrity Monitor","Watches important resources for changes."),
            ("Recovery Center","Review recent failures and recovery actions.")
        ]
        for i,(n,d) in enumerate(entries):
            r,c=divmod(i,2)
            f=tk.Frame(grid,bg=PANEL,highlightthickness=1,highlightbackground=BORDER)
            f.grid(row=r,column=c,padx=6,pady=6,sticky="nsew")
            tk.Label(f,text=n,fg=TEXT,bg=PANEL,font=("Segoe UI",11,"bold")).pack(anchor="w",padx=14,pady=(13,5))
            tk.Label(f,text=d,fg="#858ca7",bg=PANEL,wraplength=350,justify="left").pack(anchor="w",padx=14)
            tk.Label(f,text="● Ready",fg=GOOD,bg=PANEL,font=("Segoe UI",8,"bold")).pack(anchor="w",padx=14,pady=8)
            tk.Button(f,text="Manage",command=lambda n=n:self.notify(n+" opened"),
                      bg="#0b0e15",fg="#cda5ff",bd=1,relief="solid").pack(anchor="w",padx=14,pady=(0,13))
            grid.grid_rowconfigure(r,weight=1); grid.grid_columnconfigure(c,weight=1)

    def maker_page(self):
        p=self.pages["maker"]; self.heading(p,"Script Maker","Create and edit script text in the desktop workspace.")
        box=tk.Frame(p,bg=PANEL,highlightthickness=1,highlightbackground=BORDER); box.pack(fill="both",expand=True,padx=26,pady=0)
        tk.Label(box,text="Script name",fg="#b5bad0",bg=PANEL).pack(anchor="w",padx=15,pady=(15,5))
        self.script_name=tk.Entry(box,bg="#0a0e16",fg=TEXT,insertbackground="white",relief="flat")
        self.script_name.pack(fill="x",padx=15,ipady=8); self.script_name.insert(0,"My Medusa Script")
        self.code=tk.Text(box,bg="#070a10",fg="#cab8ff",insertbackground="white",relief="flat",
                          font=("Consolas",10),height=20); self.code.pack(fill="both",expand=True,padx=15,pady=15)
        self.code.insert("end",'-- Your script\nprint("Hello from Medusa Client")')
        tk.Button(box,text="Save Script",command=lambda:self.notify("Script saved"),bg=ACCENT,fg="white",bd=0,padx=14,pady=8).pack(side="left",padx=(15,5),pady=(0,15))
        tk.Button(box,text="Export",command=lambda:self.notify("Export prepared"),bg=PANEL2,fg="#c3c8da",bd=1,pady=7).pack(side="left",pady=(0,15))

    def copier_page(self):
        p=self.pages["copier"]; self.heading(p,"Game Copier","Project workflow interface for organizing a local project.")
        f=tk.Frame(p,bg=PANEL,highlightthickness=1,highlightbackground=BORDER); f.pack(fill="x",padx=26)
        for label in ["Game / Place ID","Project name"]:
            tk.Label(f,text=label,fg="#b5bad0",bg=PANEL).pack(anchor="w",padx=15,pady=(15,4))
            tk.Entry(f,bg="#0a0e16",fg=TEXT,insertbackground="white",relief="flat").pack(fill="x",padx=15,ipady=8)
        tk.Button(f,text="Start Project",command=lambda:self.notify("Project workflow started"),bg=ACCENT,fg="white",bd=0,padx=14,pady=8).pack(anchor="w",padx=15,pady=15)

    def logs_page(self):
        p=self.pages["logs"]; self.heading(p,"Activity Logs","Generate a local event stream for movement and interface activity.")
        bar=tk.Frame(p,bg=BG); bar.pack(fill="x",padx=26,pady=(0,10))
        tk.Button(bar,text="▶ Start",command=self.start_logs,bg=ACCENT,fg="white",bd=0,padx=16,pady=8).pack(side="left")
        tk.Button(bar,text="Clear",command=lambda:self.logs.delete("1.0","end"),bg=PANEL2,fg="#c3c8da",bd=1,pady=7).pack(side="left",padx=7)
        self.logs=tk.Text(p,bg="#070a10",fg="#858ca5",relief="flat",font=("Consolas",9),
                          highlightthickness=1,highlightbackground=BORDER)
        self.logs.pack(fill="both",expand=True,padx=26,pady=(0,14))

    def start_logs(self):
        self.logs.delete("1.0","end"); total=random.randint(40,200)
        events=["Mouse moved","Cursor moved","Keyboard input","Character position updated","Camera position updated","UI focus changed","Navigation event","Pointer clicked","Window focus changed"]
        for i in range(total):
            self.logs.insert("end",f"[{time.strftime('%H:%M:%S')}] {random.choice(events)} · event #{i+1}\n")
        self.logs.insert("end",f"\n✓ Activity pass complete — {total} logs generated\n")
        self.notify(f"{total} movement logs generated")

    def settings_page(self):
        p=self.pages["settings"]; self.heading(p,"Settings","Personalize the desktop client interface.")
        f=tk.Frame(p,bg=PANEL,highlightthickness=1,highlightbackground=BORDER); f.pack(fill="x",padx=26,pady=0)
        tk.Label(f,text="Accent colour",fg=TEXT,bg=PANEL,font=("Segoe UI",12,"bold")).pack(anchor="w",padx=15,pady=(15,3))
        tk.Label(f,text="Choose the main interface colour.",fg=MUTED,bg=PANEL).pack(anchor="w",padx=15)
        row=tk.Frame(f,bg=PANEL); row.pack(anchor="w",padx=15,pady=15)
        for col in ["#8b5cf6","#287cff","#e13cff","#20c98b","#ff7a24","#ff3d59"]:
            tk.Button(row,bg=col,activebackground=col,bd=0,width=4,height=2,
                      command=lambda c=col:self.notify("Theme colour changed")).pack(side="left",padx=4)

    def about_page(self):
        p=self.pages["about"]; self.heading(p,"About Medusa Client","Native desktop launcher and unified script/tool library.")
        f=tk.Frame(p,bg=PANEL,highlightthickness=1,highlightbackground=BORDER); f.pack(fill="x",padx=26)
        tk.Label(f,text="MEDUSA CLIENT",fg="#e9d5ff",bg=PANEL,font=("Segoe UI",18,"bold")).pack(anchor="w",padx=16,pady=(16,4))
        tk.Label(f,text="Desktop dashboard • Script Library • Debugger • Protection • Script Maker • Logs",
                 fg=MUTED,bg=PANEL,font=("Segoe UI",9)).pack(anchor="w",padx=16,pady=(0,16))
        tk.Label(p,text="COMPATIBILITY PROFILES",fg="#d6d1e7",bg=BG,font=("Segoe UI",10,"bold")).pack(anchor="w",padx=26,pady=(22,8))
        grid=tk.Frame(p,bg=BG); grid.pack(fill="both",expand=True,padx=20)
        for i in range(40):
            r,c=divmod(i,5)
            f=tk.Frame(grid,bg=PANEL,highlightthickness=1,highlightbackground=BORDER)
            f.grid(row=r,column=c,padx=5,pady=5,sticky="nsew")
            tk.Label(f,text=f"Profile {i+1}",fg=TEXT,bg=PANEL,font=("Segoe UI",9,"bold")).pack(anchor="w",padx=10,pady=(9,3))
            tk.Label(f,text="Compatible",fg=GOOD,bg=PANEL,font=("Segoe UI",8)).pack(anchor="w",padx=10,pady=(0,9))

    def show(self,key):
        for k,p in self.pages.items(): p.pack_forget()
        self.pages[key].pack(fill="both",expand=True)
        for k,b in self.nav_buttons.items():
            b.configure(bg="#171323" if k==key else "#080a10",fg="white" if k==key else "#9ca2bb")
        if key!="home": self.notify(key.replace("_"," ").title()+" opened")

    def notify(self,msg):
        # Small in-app status notification, no browser/toast dependencies.
        note=tk.Toplevel(self.root)
        note.overrideredirect(True); note.attributes("-topmost",True)
        note.configure(bg="#101522")
        tk.Label(note,text="✓  "+msg,fg=TEXT,bg="#101522",font=("Segoe UI",9,"bold"),
                 padx=14,pady=10).pack()
        self.root.update_idletasks()
        x=self.root.winfo_rootx()+self.root.winfo_width()-330
        y=self.root.winfo_rooty()+70
        note.geometry(f"300x42+{x}+{y}")
        note.after(1800,note.destroy)

if __name__=="__main__":
    root=tk.Tk()
    MedusaApp(root)
    root.mainloop()
